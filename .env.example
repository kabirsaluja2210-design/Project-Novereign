# --- Core infra (required) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clipforge"
REDIS_URL="redis://localhost:6379"
SESSION_SECRET="change-me-to-a-random-32-byte-value"
NEXT_PUBLIC_APP_NAME="ClipForge AI"
APP_BASE_URL="http://localhost:3000"

# --- Storage ---
# Leave unset to use local disk storage at ./storage (dev only).
STORAGE_DRIVER="local" # "local" | "s3"
STORAGE_LOCAL_DIR="./storage"
# S3-compatible (AWS S3 / Cloudflare R2 / Backblaze B2) - required if STORAGE_DRIVER=s3
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION=""

# --- AI providers (optional - app runs on Mock providers without these) ---
OPENAI_API_KEY=""
# Image generation (Replicate, flux-schnell) - https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""
# Voice generation (ElevenLabs) - https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=""

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Social publishing (optional, roadmap - not wired yet) ---
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
META_CLIENT_ID=""
META_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# --- Billing (optional, roadmap - not wired yet) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email (optional) ---
EMAIL_PROVIDER_KEY=""

# --- Observability (optional) ---
SENTRY_DSN=""
