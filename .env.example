# --- Core infra (required) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clipforge"
REDIS_URL="redis://localhost:6379"
SESSION_SECRET="change-me-to-a-random-32-byte-value"
NEXT_PUBLIC_APP_NAME="ClipForge AI"
APP_BASE_URL="http://localhost:3000"

# --- Storage ---
# Leave unset to use local disk storage at ./storage (dev only).
STORAGE_DRIVER="local" # "local" | "s3"
STORAGE_LOCAL_DIR="./storage"
# S3-compatible (AWS S3 / Cloudflare R2 / Backblaze B2) - required if STORAGE_DRIVER=s3
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION=""

# --- AI providers (all optional - see PROVIDERS.md) ---
# Voice generation works with ZERO configuration in the Docker image: Piper
# (a local, offline TTS engine - no API key, no account, no per-request
# cost) is baked into the worker image at build time and used automatically
# whenever no cloud voice key is set below. Only set OPENAI/REPLICATE/
# ELEVENLABS keys if you specifically want those paid cloud providers
# instead of the local/mock defaults.
OPENAI_API_KEY=""
# Image generation (Replicate, flux-schnell) - https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""
# Voice generation (ElevenLabs) - https://elevenlabs.io/app/settings/api-keys
# Leave blank to use the local Piper engine instead (recommended default).
ELEVENLABS_API_KEY=""
# Override only if you rebuilt the image with a different Piper voice/path.
# PIPER_BINARY_PATH="/opt/piper/piper"
# PIPER_MODEL_PATH="/opt/piper/voices/en_US-lessac-medium.onnx"

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Social publishing (optional, roadmap - not wired yet) ---
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
META_CLIENT_ID=""
META_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# --- Billing (optional, roadmap - not wired yet) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email (optional) ---
EMAIL_PROVIDER_KEY=""

# --- Observability (optional) ---
SENTRY_DSN=""
