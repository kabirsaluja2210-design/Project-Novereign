// ClipForge AI - core data model.
// See ARCHITECTURE.md for how these tables are used by the pipeline.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth & accounts
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
  SUPPORT
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String?
  name                String?
  avatarUrl           String?
  role                UserRole   @default(USER)
  status              UserStatus @default(ACTIVE)
  planId              String?
  plan                Plan?      @relation(fields: [planId], references: [id])
  creditBalance       Int        @default(0)
  timezone            String     @default("UTC")
  defaultLanguage     String     @default("en")
  onboardingCompleted Boolean    @default(false)
  onboardingData      Json?
  emailVerifiedAt     DateTime?
  trialStartedAt      DateTime?
  trialCredits        Int?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  sessions           Session[]
  oauthAccounts      OAuthAccount[]
  creditTransactions CreditTransaction[]
  projects           Project[]
  characters         Character[]
  brands             Brand[]
  templates          Template[]
  jobs               Job[]
  socialAccounts     SocialAccount[]
  automations        Automation[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  supportTickets     SupportTicket[]

  @@index([email])
  @@index([planId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

enum OAuthProvider {
  GOOGLE
}

model OAuthAccount {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Plans & billing
// ---------------------------------------------------------------------------

model Plan {
  id                  String   @id @default(cuid())
  key                 String   @unique // FREE | STARTER | PRO | ADVANCED | ENTERPRISE
  name                String
  monthlyCredits      Int
  priceCentsMonthly   Int
  maxVideoDurationSec Int
  maxSocialAccounts   Int
  priorityWeight      Int      @default(1) // used for fair-share queue scheduling
  entitlements        Json // e.g. {"AUTOMATION": true, "THREE_D": false, ...}
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users User[]
}

enum CreditTransactionType {
  SUBSCRIPTION_GRANT
  PURCHASE
  GENERATION_RESERVE
  GENERATION_SETTLEMENT
  GENERATION_REFUND
  ADMIN_ADJUSTMENT
  PROMOTIONAL_CREDIT
  EXPIRATION
}

// Immutable ledger. Never update or delete rows here.
model CreditTransaction {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         CreditTransactionType
  amount       Int // signed; negative = debit
  balanceAfter Int
  source       String // e.g. "quick_create", "admin", "stripe"
  referenceId  String? // e.g. jobId, projectId, stripe event id
  description  String?
  createdAt    DateTime              @default(now())

  @@index([userId, createdAt])
  @@index([referenceId])
}

// ---------------------------------------------------------------------------
// Creative library: styles, templates, voices, characters, brands
// ---------------------------------------------------------------------------

model Style {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  category       String
  promptSuffix   String
  negativePrompt String?
  thumbnailUrl   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  projects Project[]
}

model Template {
  id                 String   @id @default(cuid())
  ownerUserId        String?
  owner              User?    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  name               String
  category           String
  description        String?
  thumbnailUrl       String?
  sceneCount         Int?
  defaultDurationSec Int?
  defaultStyleKey    String?
  promptStructure    Json?
  captionStyle       String?
  voiceStyle         String?
  musicStyle         String?
  isPublic           Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([ownerUserId])
}

model Voice {
  id              String   @id @default(cuid())
  provider        String // "mock" | "elevenlabs" | ...
  providerVoiceId String
  name            String
  gender          String?
  ageCategory     String?
  language        String
  accent          String?
  styleTags       String[]
  previewUrl      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([language])
  @@index([provider])
}

model Character {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  referenceImageUrl String?
  description       String // canonical description injected into every scene prompt
  age               String?
  appearance        String?
  clothing          String?
  style             String?
  voiceId           String?
  seed              String? // provider seed/reference metadata for consistency
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model Brand {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  logoUrl        String?
  primaryFont    String?
  accentColor    String?
  captionPreset  String?
  introMediaUrl  String?
  outroMediaUrl  String?
  watermarkUrl   String?
  defaultVoiceId String?
  ctaText        String?
  createdAt      DateTime @default(now())

  projects Project[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Projects, scenes, media, voice segments
// ---------------------------------------------------------------------------

enum ProjectStatus {
  DRAFT
  GENERATING
  READY
  FAILED
  PUBLISHED
}

enum AspectRatio {
  RATIO_9_16
  RATIO_16_9
  RATIO_1_1
  RATIO_4_5
}

enum GenerationQuality {
  DRAFT
  STANDARD
  PREMIUM
}

model Project {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  idea            String // the original user prompt
  status          ProjectStatus     @default(DRAFT)
  aspectRatio     AspectRatio       @default(RATIO_9_16)
  durationSec     Int
  language        String            @default("en")
  styleId         String?
  style           Style?            @relation(fields: [styleId], references: [id])
  brandId         String?
  brand           Brand?            @relation(fields: [brandId], references: [id])
  quality         GenerationQuality @default(STANDARD)
  voiceId         String?
  captionsEnabled Boolean           @default(true)
  musicEnabled    Boolean           @default(false)
  sfxEnabled      Boolean           @default(false)
  creditEstimate  Int?
  creditActual    Int?
  finalVideoUrl   String?
  thumbnailUrl    String?
  errorMessage    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  scenes        Scene[]
  media         Media[]
  voiceSegments VoiceSegment[]
  jobs          Job[]

  @@index([userId, createdAt])
  @@index([status])
}

enum SceneStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

model Scene {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  index          Int
  durationSec    Float
  scriptText     String
  visualPrompt   String
  motionPrompt   String?
  transition     String        @default("crossfade")
  status         SceneStatus   @default(PENDING)
  mediaId        String?
  media          Media?        @relation(fields: [mediaId], references: [id])
  voiceSegmentId String?
  voiceSegment   VoiceSegment? @relation(fields: [voiceSegmentId], references: [id])
  errorMessage   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([projectId, index])
  @@index([projectId])
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  LOGO
}

model Media {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type            MediaType
  provider        String
  providerKind    String // "mock" | "real"
  providerAssetId String?
  storageUrl      String
  thumbnailUrl    String?
  durationSec     Float?
  width           Int?
  height          Int?
  mimeType        String?
  prompt          String?
  seed            String?
  metadata        Json?
  costUnits       Int       @default(0)
  createdAt       DateTime  @default(now())

  scenes Scene[]

  @@index([projectId])
}

model VoiceSegment {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text         String
  provider     String
  providerKind String // "mock" | "real"
  voiceId      String?
  audioUrl     String
  durationSec  Float
  timingData   Json? // word/phrase-level timestamps
  costUnits    Int      @default(0)
  createdAt    DateTime @default(now())

  scenes Scene[]

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Jobs / durable pipeline
// ---------------------------------------------------------------------------

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  RETRYING
}

model Job {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type             String    @default("video_generation")
  status           JobStatus @default(QUEUED)
  reservationTxnId String?
  clientRequestId  String?   @unique // idempotency key
  errorMessage     String?
  createdAt        DateTime  @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?

  steps JobStep[]

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

model JobStep {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage      String // "script_generation" | "scene_planning" | "image_generation" | ...
  sequence   Int
  status     JobStatus @default(QUEUED)
  attempts   Int       @default(0)
  input      Json?
  output     Json?
  lastError  String?
  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([jobId, stage])
  @@index([jobId])
}

model ProviderUsage {
  id            String   @id @default(cuid())
  provider      String
  capability    String // "text" | "image" | "voice" | "music" | "video"
  model         String?
  jobId         String?
  userId        String?
  projectId     String?
  success       Boolean
  estimatedCost Int
  actualCost    Int?
  durationMs    Int?
  errorCode     String?
  createdAt     DateTime @default(now())

  @@index([provider, capability])
  @@index([createdAt])
}

model ProviderConfig {
  id         String   @id @default(cuid())
  capability String // "text" | "image" | "voice" | "music" | "video"
  provider   String
  priority   Int      @default(100) // lower = tried first
  enabled    Boolean  @default(true)
  config     Json? // non-secret config; secrets stay in env vars
  updatedAt  DateTime @updatedAt

  @@unique([capability, provider])
}

// ---------------------------------------------------------------------------
// Publishing (architecture only for this build - see PRODUCT_SPEC roadmap)
// ---------------------------------------------------------------------------

enum SocialPlatform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
  FACEBOOK
  X
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  DISCONNECTED
}

model SocialAccount {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform              SocialPlatform
  platformUserId        String
  displayName           String?
  avatarUrl             String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  expiresAt             DateTime?
  status                SocialAccountStatus @default(CONNECTED)
  createdAt             DateTime            @default(now())

  publishedPosts PublishedPost[]

  @@index([userId])
}

enum PublishStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model PublishedPost {
  id              String         @id @default(cuid())
  projectId       String
  socialAccountId String
  socialAccount   SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  platform        SocialPlatform
  postId          String?
  url             String?
  status          PublishStatus  @default(SCHEDULED)
  scheduledFor    DateTime?
  publishedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime       @default(now())

  @@index([projectId])
  @@index([socialAccountId])
}

// ---------------------------------------------------------------------------
// Automation (architecture only - see PRODUCT_SPEC roadmap)
// ---------------------------------------------------------------------------

model Automation {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  enabled           Boolean  @default(false)
  cronExpression    String
  timezone          String   @default("UTC")
  platforms         String[]
  styleId           String?
  durationSec       Int?
  voiceId           String?
  brandId           String?
  maxVideosPerDay   Int      @default(1)
  maxCreditsPerDay  Int      @default(500)
  notificationEmail String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  topics AutomationTopic[]

  @@index([userId])
}

enum TopicStatus {
  AVAILABLE
  IN_PROGRESS
  USED
  FAILED
  SKIPPED
}

model AutomationTopic {
  id           String      @id @default(cuid())
  automationId String
  automation   Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  title        String
  category     String?
  status       TopicStatus @default(AVAILABLE)
  priority     Int         @default(0)
  usedCount    Int         @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime    @default(now())

  @@index([automationId, status])
}

// ---------------------------------------------------------------------------
// Notifications, audit, support, flags
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String?
  message   String
  status    SupportTicketStatus @default(OPEN)
  priority  String              @default("normal")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  payload   Json?
  updatedAt DateTime @updatedAt
}
